rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Merchant Profiles & Requests
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /seller_requests/{requestId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Business Collaboration Requests & Active Collaborations
    match /collaboration_requests/{reqId} {
      allow read, create, update, delete: if true;
    }

    match /collaborations/{collabId} {
      allow read, create, update, delete: if true;
    }

    // API Key Management & Subscriptions
    match /api_keys/{keyId} {
      allow create, read, update, delete: if true;
    }

    match /my_subscription_apis/{subId} {
      allow create, read, update, delete: if true;
    }

    // 1. Website Registry Management
    match /external_sites/{siteId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // 2. Nested Analytics Data
      match /events/{eventId} {
        allow create: if true; // Public ingestion
        allow read: if request.auth != null && get(/databases/$(database)/documents/external_sites/$(siteId)).data.ownerId == request.auth.uid;
      }

      match /sessions/{sessionId} {
        allow create, update: if true; // Public ingestion
        allow read: if request.auth != null && get(/databases/$(database)/documents/external_sites/$(siteId)).data.ownerId == request.auth.uid;
      }

      // 3. Push Notifications
      match /subscribers/{subscriberId} {
        allow create, update: if true; // Public subscription
        allow read, delete: if request.auth != null && get(/databases/$(database)/documents/external_sites/$(siteId)).data.ownerId == request.auth.uid;
      }

      match /campaigns/{campaignId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/external_sites/$(siteId)).data.ownerId == request.auth.uid;
      }
    }

    // 2. Playwright Autonomous Browser Automations
    match /automations/{autoId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    match /webhook_inbox/{msgId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // 3. Global Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
